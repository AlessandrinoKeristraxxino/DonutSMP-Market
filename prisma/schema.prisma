datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  MOD
  ADMIN
}

enum Section {
  MAP_ART
  MARKET
  BUILD
}

enum ListingKind {
  // Map Art
  ARTWORK
  COMMISSION_OFFER
  // Market
  SELL
  BUY
  // Build
  SERVICE
  REQUEST
}

enum OrderType {
  MAP_ART
  TRADE
  BUILD
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum VouchRating {
  POSITIVE
  NEGATIVE
}

enum ModerationStatus {
  APPROVED
  NEEDS_REVIEW
  REJECTED
}

enum ReportTargetType {
  LISTING
  ORDER_MESSAGE
  VOUCH
  USER
}

model User {
  id            String    @id @default(cuid())
  discordId     String?   @unique
  name          String?
  email         String?   @unique
  image         String?
  minecraftIgn  String    @unique
  bio           String?   @db.VarChar(500)
  role          Role      @default(USER)
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings        Listing[]
  quotesGiven     Quote[]
  ordersAsBuyer   Order[]         @relation("BuyerOrders")
  ordersAsSeller  Order[]         @relation("SellerOrders")
  vouchesGiven    Vouch[]         @relation("VouchesGiven")
  vouchesReceived Vouch[]         @relation("VouchesReceived")
  reportsFiled    Report[]        @relation("ReportsFiled")
  auditLogs       AuditLog[]
  messagesSent    OrderMessage[]
}

model Listing {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  section      Section
  kind         ListingKind
  title        String           @db.VarChar(120)
  description  String           @db.VarChar(5000)
  price        BigInt?
  isNegotiable Boolean          @default(false)
  isFulfilled  Boolean          @default(false)
  isPaused     Boolean          @default(false)
  details      Json
  modStatus    ModerationStatus @default(APPROVED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  images       ListingImage[]
  quotes       Quote[]
  orders       Order[]

  @@index([section, kind])
  @@index([userId])
  @@index([createdAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Quote {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  builderId  String
  builder    User     @relation(fields: [builderId], references: [id], onDelete: Cascade)
  price      BigInt
  etaDays    Int
  message    String   @db.VarChar(1000)
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders     Order[]

  @@index([listingId])
  @@index([builderId])
}

model Order {
  id                   String       @id @default(cuid())
  orderNumber          Int          @unique @default(autoincrement())
  type                 OrderType
  status               OrderStatus  @default(REQUESTED)
  buyerId              String
  buyer                User         @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId             String
  seller               User         @relation("SellerOrders", fields: [sellerId], references: [id])
  listingId            String?
  listing              Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  quoteId              String?
  quote                Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  agreedPrice          BigInt
  agreedQuantity       Int          @default(1)
  itemOrService        String       @db.VarChar(150)

  buyerPaidInGame      Boolean      @default(false)
  sellerReceivedInGame Boolean      @default(false)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  events               OrderEvent[]
  messages             OrderMessage[]
  vouches              Vouch[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String
  status    OrderStatus
  note      String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Vouch {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation("VouchesGiven", fields: [authorId], references: [id])
  targetId  String
  target    User             @relation("VouchesReceived", fields: [targetId], references: [id])
  rating    VouchRating
  content   String           @db.VarChar(1500)
  modStatus ModerationStatus @default(NEEDS_REVIEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  images    VouchImage[]

  @@unique([orderId, authorId])
  @@index([targetId, modStatus])
  @@index([authorId])
}

model VouchImage {
  id        String   @id @default(cuid())
  vouchId   String
  vouch     Vouch    @relation(fields: [vouchId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)

  @@index([vouchId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String           @db.VarChar(500)
  status     ModerationStatus @default(NEEDS_REVIEW)
  createdAt  DateTime         @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model ModerationItem {
  id          String           @id @default(cuid())
  contentType String           @db.VarChar(50)
  contentId   String
  authorId    String
  flagReason  String           @db.VarChar(500)
  status      ModerationStatus @default(NEEDS_REVIEW)
  createdAt   DateTime         @default(now())

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(50)
  targetId   String   @db.VarChar(100)
  details    Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  filename  String   @db.VarChar(255)
  size      Int
  mimeType  String   @db.VarChar(100)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}
